# Copy this file to .env.local for local development.
# Find both values in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. A Microlink API key helps import from shops that block normal visits (Amazon and similar).
# Leave empty to skip. https://microlink.io
MICROLINK_API_KEY=

# Optional. The main address; name pages live at <name>.<this>. For local testing use localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=transitorythings.com
